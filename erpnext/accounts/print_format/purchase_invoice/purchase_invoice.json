 "css": ".heading-block{\r\n    width: 50%;\r\n    float: left;\r\n    height: 100px;\r\n}\r\n.print-heading {\r\n    border-bottom: 0 !important\r\n}\r\n.lbl_title{\r\n    color: #076EBB;\r\n    border-bottom: 1px solid;\r\n\r\n}\r\n.info-block{\r\n    width:100px;\r\n    float: right;\r\n}\r\n.print-format th{\r\n    background-color: #6ab16a !important;\r\n    color: white;\r\n}\r\nth.table-sr{\r\n text-indent: -9999px;\r\n  line-height: 0; /* Collapse the original line */\r\n}\r\nth.table-sr:after{\r\n   content: \"No\";\r\n  text-indent: 0;\r\n  display: block;\r\n  line-height: initial; /* New content takes up original line height */\r\n}\r\n\r\n#footer-html2 {\r\n        display: flex;\r\n        flex-direction: row-reverse;\r\n}\r\n\r\n@media print\r\n{\r\n    #footer-html2 {\r\n        position: fixed;\r\n        display: block;\r\n        left: 83.333%;\r\n        z-index: 1000;\r\n        bottom: 0;\r\n\r\n    }\r\n}",
 "custom_format": 1,
 "default_print_language": "es",
 "disabled": 0,
 "doc_type": "Purchase Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div id=\"header-html\" class=\"hidden-pdf\">\r\n  <div class=\"print-heading\">\r\n    <div class=\"heading-block text-left\">\r\n      <br /><br />\r\n      <h2>{{_(\"Purchase Invoice\")}}</h2>\r\n    </div>\r\n    <div class=\"heading-block\">\r\n      <img\r\n        src=\"/files/images/proedom_logo.png\"\r\n        style=\"height: 65px; float: right\"\r\n      />\r\n    </div>\r\n  </div>\r\n  {% if doc.status == \"Draft\" %}\r\n  <div class=\"text-center\" document-status=\"draft\">\r\n    <h4 style=\"margin: 0px\">DRAFT</h4>\r\n  </div>\r\n  {% endif %}\r\n</div>\r\n\r\n<div id=\"footer-html\" class=\"visible-pdf\">\r\n  <p class=\"text-center small page-number visible-pdf\">\r\n    P\u00e1gina <span class=\"page\"></span> de <span class=\"topage\"></span>\r\n  </p>\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-6 column-break\">\r\n    <div>\r\n      {%set phone = frappe.db.get_value(\"Company\", doc.company, \"phone_no\") %}\r\n      <p><label>{{doc.company}}</label></p>\r\n      <p>{{frappe.db.get_value(\"Company\", doc.company, \"website\") or \"\"}}</p>\r\n      <p>{{frappe.db.get_value(\"Company\", doc.company, \"email\") or \"\"}}</p>\r\n      {%if phone %}\r\n      <p>({{phone[0:3]}}) {{phone[3:6]}}-{{phone[6:11]}}</p>\r\n      {%endif%}\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 column-break\">\r\n    <div>\r\n      <div>\r\n        <div class=\"text-right\" style=\"width: 100%\">\r\n          <div class=\"info-block\">\r\n            <div class=\"text-center\">\r\n              <label class=\"lbl_title\"> Fecha Factura de Proveedor</label>\r\n            </div>\r\n            <div class=\"text-center\">\r\n              <label>\r\n                {{frappe.utils.get_datetime(doc.posting_date).strftime(\"%d-%m-%Y\")\r\n                }}\r\n              </label>\r\n            </div>\r\n            <div class=\"text-center\">\r\n              <label class=\"lbl_title\"> Fecha de Vencimiento </label>\r\n            </div>\r\n            <div class=\"text-center\">\r\n              <label>\r\n                {{frappe.utils.get_datetime(doc.due_date).strftime(\"%d-%m-%Y\")\r\n                }}\r\n              </label>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-6 column-break\">\r\n    <div>\r\n      {% set rnc = frappe.db.get_value(\"Supplier\", doc.supplier, \"tax_id\") %}\r\n      <label class=\"lbl_title\"> {{_(\"Supplier\")}} </label>\r\n      {{doc.supplier_name}}<br />\r\n      {% if rnc%}\r\n      {{rnc}}<br />\r\n      {% endif %}\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 column-break\">\r\n    <label class=\"lbl_title\">No. Factura </label>\r\n    <div>\r\n      {{doc.name}}\r\n    </div>\r\n    <label class=\"lbl_title\"> No. Proveedor </label>\r\n    <div>\r\n         {{doc.supplier_invoice_no}}\r\n    </div>\r\n\r\n    <label class=\"lbl_title\"> NCF Proveedor </label>\r\n    <div>\r\n        {{doc.bill_no}}\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n  <div class=\"row section-break\">\r\n    <div class=\"col-xs-12 column-break\">\r\n      <div data-fieldname=\"items\" data-fieldtype=\"Table\">\r\n        <table class=\"table table-bordered table-condensed\">\r\n          <thead>\r\n            <tr>\r\n              <th style=\"width: 40px\" class=\"table-sr\">Sr</th>\r\n              <th\r\n                style=\"width: 150px\"\r\n                class=\"\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                {{_(\"Item\")}}\r\n              </th>\r\n              <th\r\n                style=\"width: 150px\"\r\n                class=\"\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                {{_(\"Item No\")}}\r\n              </th>\r\n              <th\r\n                style=\"width: 200px\"\r\n                class=\"\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                {{_(\"Description\")}}\r\n              </th>\r\n\r\n              <th\r\n                style=\"width: 80px\"\r\n                class=\"text-right\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                {{_(\"Quantity\")}}\r\n              </th>\r\n\r\n              <th\r\n                style=\"width: 80px\"\r\n                class=\"text-right\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                {{_(\"Rate\")}}\r\n              </th>\r\n\r\n              <th\r\n                style=\"width: 80px\"\r\n                class=\"text-right\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                {{_(\"Amount\")}}\r\n              </th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            {% set i = 1 %} {% for item in doc.items %}\r\n            <tr>\r\n              <td class=\"table-sr\">{{i}}</td>\r\n\r\n              <td class=\"\" data-fieldname=\"items\" data-fieldtype=\"Table\">\r\n                <div class=\"value\">{{item.item_code}}</div>\r\n              </td>\r\n             <td class=\"\" data-fieldname=\"items\" data-fieldtype=\"Table\">\r\n                <div class=\"value\">{{item.item_no or \"\"}}</div>\r\n              </td>\r\n\r\n              <td class=\"\" data-fieldname=\"items\" data-fieldtype=\"Table\">\r\n                <div class=\"value\">{{item.item_name}}</div>\r\n              </td>\r\n\r\n              <td\r\n                class=\"text-right\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                <div class=\"value\">\r\n                  <small class=\"pull-left\">{{_(item.uom)}}</small>\r\n\r\n                  {{item.qty}}\r\n                </div>\r\n              </td>\r\n\r\n              <td\r\n                class=\"text-right\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                <div class=\"value\">\r\n                  {{frappe.format_value(item.rate, {\"fieldtype\":\"Currency\"})}}\r\n                </div>\r\n              </td>\r\n\r\n              <td\r\n                class=\"text-right\"\r\n                data-fieldname=\"items\"\r\n                data-fieldtype=\"Table\"\r\n              >\r\n                <div class=\"value\">\r\n                  {{frappe.format_value(item.amount, {\"fieldtype\":\"Currency\"})}}\r\n                </div>\r\n              </td>\r\n            </tr>\r\n            {% set i = i + 1 %} {% endfor %}\r\n          </tbody>\r\n        </table>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"row section-break\">\r\n    <div class=\"col-xs-6 column-break\">\r\n      <div\r\n        class=\"row data-field\"\r\n        data-fieldname=\"total_qty\"\r\n        data-fieldtype=\"Float\"\r\n      >\r\n        <div class=\"col-xs-5\">\r\n          <label> Cantidad Total</label>\r\n        </div>\r\n        <div class=\"col-xs-7 text-right value\">{{ doc.total_qty}}</div>\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"col-xs-6 column-break\">\r\n      <div\r\n        class=\"row data-field\"\r\n        data-fieldname=\"net_total\"\r\n        data-fieldtype=\"Currency\"\r\n      >\r\n        <div class=\"col-xs-5\">\r\n          <label>Total Neto</label>\r\n        </div>\r\n        <div class=\"col-xs-7 text-right value\">\r\n          {{doc.get_formatted('total') or \"$ 0.00\"}}\r\n        </div>\r\n      </div>\r\n\r\n      <div>\r\n        <div\r\n          class=\"row data-field\"\r\n          data-fieldname=\"discount_amount\"\r\n          data-fieldtype=\"Currency\"\r\n        >\r\n          <div class=\"col-xs-5\">\r\n            <label>Descuento</label>\r\n          </div>\r\n          <div class=\"col-xs-7 text-right value\">\r\n            {{doc.get_formatted('discount_amount') or \"$ 0.00\"}}\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div>\r\n        <div\r\n          class=\"row data-field\"\r\n          data-fieldname=\"total_taxes_and_charges\"\r\n          data-fieldtype=\"Currency\"\r\n        >\r\n          <div class=\"col-xs-5\">\r\n            <label>ITBIS</label>\r\n          </div>\r\n          <div class=\"col-xs-7 text-right value\">\r\n            {{doc.get_formatted('total_taxes_and_charges') or \"$ 0.00\"}}\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"row section-break\">\r\n    <div class=\"col-xs-6 column-break\">\r\n    <img\r\n      src=\"/files/Logo y Firma Proedom1.png\"\r\n      style=\"height: 187.5px; width: 117px\"\r\n    />\r\n    <div style=\"\r\n    border-top: 2px solid black;\r\n    width: 45%;\r\n    text-align: center;\r\n    position: absolute;\r\n    bottom: 5em;\r\n    left: 1px;\r\n\"><label>{{_(\"Firma Autorizada\")}}</label></div>\r\n    </div>\r\n\r\n    <div class=\"col-xs-6 column-break\">\r\n      <div\r\n        class=\"row important data-field\"\r\n        data-fieldname=\"grand_total\"\r\n        data-fieldtype=\"Currency\"\r\n      >\r\n        <div class=\"col-xs-5\">\r\n          <label> Total</label>\r\n        </div>\r\n        <div class=\"col-xs-7 text-right value\">\r\n          {{doc.get_formatted('grand_total') or \"$ 0.00\"}}\r\n        </div>\r\n      </div>\r\n\r\n      <div\r\n        class=\"row important data-field\"\r\n        data-fieldname=\"grand_total\"\r\n        data-fieldtype=\"Currency\"\r\n      >\r\n        <div class=\"col-xs-5\">\r\n          <label> Moneda</label>\r\n        </div>\r\n        <div class=\"col-xs-7 text-right value\">\r\n          {{doc.currency}}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n",
