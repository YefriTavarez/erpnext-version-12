 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<span> </span>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"company\", \"print_hide\": 0, \"label\": \"Compa\\u00f1\\u00eda\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"posting_date\", \"print_hide\": 0, \"label\": \"Fecha de Contabilizaci\\u00f3n\"}, {\"fieldname\": \"title\", \"print_hide\": 0, \"label\": \"Nombre\"}, {\"fieldtype\": \"Section Break\", \"label\": \"Printing Settings\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"pay_to_recd_from\", \"print_hide\": 0, \"label\": \"Pagar a / Recibido de\"}, {\"fieldname\": \"total_amount\", \"print_hide\": 0, \"label\": \"Importe total\"}, {\"fieldname\": \"user_remark\", \"print_hide\": 0, \"label\": \"Observaciones\"}, {\"fieldname\": \"total_amount\", \"print_hide\": 0, \"label\": \"Importe total\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"accounts\", \"print_hide\": 0, \"label\": \"Asientos contables\", \"visible_columns\": [{\"fieldname\": \"account\", \"print_width\": \"250px\", \"print_hide\": 0}, {\"fieldname\": \"debit_in_account_currency\", \"print_width\": \"\", \"print_hide\": 0}, {\"fieldname\": \"credit_in_account_currency\", \"print_width\": \"\", \"print_hide\": 0}]}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"HTML Personalizado\", \"fieldtype\": \"HTML\", \"options\": \"_______________ <br>\\n   APROBADO\"}]",
 "html": "{% if doc.voucher_type == \"Petty Cash Replacement\" %} \n<div class=\"page-break\" style=\"display: flex; flex-direction: column; flex: 1 1 0%;\">\n   <div id=\"header-html\" class=\"hidden-pdf\">\n      <span> </span>\n   </div>\n   <div id=\"footer-html\" class=\"visible-pdf\" style=\"\n      display: block !important;\n      order: 1;\n      margin-top: auto;\n      \">\n      <p class=\"text-center small page-number visible-pdf\">\n         P\u00e1gina <span class=\"page\"></span> de <span class=\"topage\"></span>\n      </p>\n   </div>\n   <div class=\"row section-break\">\n      <div class=\"col-xs-6 column-break\">\n         <div class=\"row  data-field\" data-fieldname=\"company\" data-fieldtype=\"Link\">\n            <div class=\"col-xs-12 \">\n               <p>LOGOMARCA, S.A.</p>\n               <p>ROMULO BETANCOURT 1210</p>\n               <p>TEL. 809-535-8445</p>\n\n            </div>\n         </div>\n      </div>\n      <div class=\"col-xs-6 column-break\">\n         <div class=\"row  data-field\" data-fieldname=\"posting_date\" data-fieldtype=\"Date\">\n            <div class=\"col-xs-12 text-right\">\n               <p>Comprobante Caja Chica: {{doc.name}}</p>\n               <p>Fecha: {{doc.get_formatted('posting_date')}}</p>\n            </div>\n         </div>\n      </div>\n   </div>\n   <br>\n   <br>\n<div class=\"row section-break\">\n      <div class=\"col-xs-8 column-break\">\n         <div class=\"row  data-field\" data-fieldname=\"pay_to_recd_from\" data-fieldtype=\"Data\">\n            <div class=\"col-xs-4\">\n               <label>Beneficiario</label>\n            </div>\n            <div class=\"col-xs-8\n               value\">\n               {{doc.pay_to_recd_from}}\n            </div>\n         </div>\n         <div class=\"row important data-field\" data-fieldname=\"total_amount\" data-fieldtype=\"Currency\">\n            <div class=\"col-xs-4\">\n               <label>Recib\u00ed la suma de</label>\n            </div>\n            <div class=\"col-xs-8 text-left \">\n                {{frappe.utils.money_in_words(doc.total_amount).replace(\"DOP\", \"\").replace(\"solo.\", \" PESOS CON 00/100\").upper()}}\n            </div>\n         </div>\n         <div class=\"row  data-field\" data-fieldname=\"user_remark\" data-fieldtype=\"Small Text\">\n            <div class=\"col-xs-4\">\n               <label>Observaciones</label>\n            </div>\n            <div class=\"col-xs-8\n               value\">\n               {{doc.user_remark or \"-\"}}\n            </div>\n         </div>\n         <div class=\"row important data-field\" data-fieldname=\"total_amount\" data-fieldtype=\"Currency\">\n            <div class=\"col-xs-4\">\n               <label>Valor RD$********</label>\n            </div>\n            <div class=\"col-xs-8\n               text-left value\">\n               {{doc.get_formatted('total_amount')}}\n            </div>\n         </div>\n      </div>\n      <div class=\"col-xs-4 column-break\">\n      </div>\n   </div>\n   <div class=\"row section-break\">\n      <div class=\"col-xs-12 column-break\">\n         <div data-fieldname=\"accounts\" data-fieldtype=\"Table\">\n            <table class=\"table table-bordered table-condensed\">\n               <thead>\n                  <tr>\n                     <th style=\"width: 250px;\" class=\"text-center\" data-fieldname=\"accounts\" data-fieldtype=\"Table\">\n                        Cuenta\n                     </th>\n                     <th style=\"width: 80px;\" class=\"text-center\" data-fieldname=\"accounts\" data-fieldtype=\"Table\">\n                        D\u00e9bito\n                     </th>\n                     <th style=\"width: 80px;\" class=\"text-center\" data-fieldname=\"accounts\" data-fieldtype=\"Table\">\n                        Cr\u00e9dito\n                     </th>\n                  </tr>\n               </thead>\n               <tbody>\n               \t\t{% for row in doc.accounts %}\n               \t\t<tr>\n               \t\t\t<td class=\"\" data-fieldname=\"accounts\" data-fieldtype=\"Table\">\n\t                        <div class=\"value\">\n\t                          {{row.account}}\n\t                        </div>\n                     \t</td>\n\t                     <td class=\"text-right\" data-fieldname=\"accounts\" data-fieldtype=\"Table\">\n\t                        <div class=\"value\">\n\t                           {{row.get_formatted('debit')}}\n\t                        </div>\n\t                     </td>\n                     <td class=\"text-right\" data-fieldname=\"accounts\" data-fieldtype=\"Table\">\n                        <div class=\"value\">\n                        \t{{row.get_formatted('credit')}}\n                        </div>\n                     </td>\n               \t\t</tr>\n\n               \t\t{% endfor %}\n               </tbody>\n            </table>\n         </div>\n      </div>\n   </div>\n   <br>\n   <br>\n   <br>\n   <div class=\"row section-break\">\n      <div class=\"col-xs-6 column-break\">\n         <div>______________________________ <br>\n            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;APROBADO\n         </div>\n      </div>\n      <div class=\"col-xs-6 column-break\">\n         <div>\n              NOMBRE: ___________________________<br><br>\n              CEDULA: ____________________________       \n         </div>\n      </div>\n   </div>\n</div>\n{% else %}\n<div class=\"text-center\" style=\"width: 100%; height: 500px;\">\n\tEl tipo de asiento seleccionado no es v\u00e1lido.\n</div>\n{% endif %}",
