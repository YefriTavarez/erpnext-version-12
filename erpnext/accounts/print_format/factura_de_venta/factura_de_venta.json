 "format_data": "[{\"fieldname\": \"print_heading_template\", \"fieldtype\": \"Custom HTML\", \"options\": \"<div class=\\\"print-heading\\\">\\t\\t\\t\\t\\r\\n    <div>\\r\\n        <img src=\\\"/files/Logo.png\\\" style=\\\" float: left;\\\">\\r\\n    </div>\\r\\n    <h2>\\r\\n        {{_(\\\"Sales Invoice\\\")}}\\r\\n    </h2>\\r\\n        <small>{{ doc.cc_reference }}</small><br>\\r\\n        <small><b>RNC: 101-16205-8</b></small>\\r\\n    \\r\\n</div>\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<div class=\\\"col-xs-12 column-break\\\">\\r\\n    <div class=\\\"col-xs-6 column-break\\\">\\r\\n      <div class=\\\"div-striped\\\" style=\\\"font-size: 11px;\\\">\\r\\n        {% set company = frappe.get_doc(\\\"Company\\\", doc.company) %}\\r\\n        {% if doc.sales_team | length > 0 %}\\r\\n        {% set sales_person = frappe.get_doc(\\\"Sales Person\\\", doc.sales_team[0].sales_person) %}\\r\\n        {% set employee = frappe.get_doc(\\\"Employee\\\", sales_person.employee)%}\\r\\n        {% endif %}\\r\\n        <div><b>{{_(\\\"Customer\\\")}}: </b>{{doc.customer_name}}<br></div>\\r\\n        <div><b>RNC/C\\u00e9dula:</b> {{doc.tax_id}}<br></div>\\r\\n        <div><b>Telefono:</b><br></div>\\r\\n        <div><b>Direcci\\u00f3n:</b> {{doc.customer_address}} <br></div>\\r\\n      </div>\\r\\n    </div>\\r\\n    <div class=\\\"col-xs-6 column-break\\\">\\r\\n      <div class=\\\"div-striped\\\" style=\\\"font-size: 11px;\\\">\\r\\n        {% set customer = frappe.get_doc(\\\"Customer\\\", doc.customer) %}\\r\\n        <div><b>Fecha:</b> {{doc.posting_date}} <br> </div>\\r\\n        <div><b>Vendedor/a: </b>{{frappe.db.get_value(\\\"User\\\", doc.owner, \\\"full_name\\\")}}</div>\\r\\n        <div><b>Entrega:</b> {{ frappe.format_date(doc.delivery_date)}} @ {{doc.posting_time}} <br></div>\\r\\n        <div> <b>Surcursal: </b> Santo Domingo <br></div>\\r\\n        {% if doc.contact_person %}\\r\\n          {% set contact = frappe.db.get_value(\\\"Contact\\\", doc.contact_person, [\\\"first_name\\\", \\\"last_name\\\", \\\"mobile_no\\\", \\\"email_id\\\"], as_dict=True) %}\\r\\n        <div>{{_(\\\"Attention\\\")}}: {{contact.first_name or \\\"\\\"}} {{contact.last_name or \\\"\\\"}}</div>\\r\\n        <div> Email: {{contact.email_id or \\\"\\\"}}</div>\\r\\n        <div>{{_(\\\"Phone\\\")}}: {{contact.mobile_no or \\\"\\\"}}</div>\\r\\n        {% endif %}\\r\\n      </div>\\r\\n    </div>\\r\\n</div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"{% set maxRowsCount = 7 %}\\r\\n<div class=\\\"col-xs-12 column-break\\\">\\r\\n    <div data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n        <table class=\\\"table table-bordered table-condensed\\\" id=\\\"items\\\">\\r\\n          <thead>\\r\\n            <tr>\\r\\n                <th style=\\\"width: 200px;\\\" class=\\\"\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">C\\u00f3digo</th>\\r\\n                <th style=\\\"width: 600px;\\\" class=\\\"\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">Descripci\\u00f3n</th>\\r\\n                <th style=\\\"width: 100px;\\\" class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">Cant.</th>\\r\\n                <th style=\\\"width: 100px;\\\" class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">Precio</th>\\r\\n                <th style=\\\"width: 100px;\\\" class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">Importe</th>\\r\\n            </tr>\\r\\n          </thead>\\r\\n          <tbody>\\r\\n            {% for item in doc.items %}\\r\\n            <tr>\\r\\n              <td class=\\\"\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n                <div class=\\\"value\\\">{{item.item_code}}</div>\\r\\n              </td>\\r\\n              <td class=\\\"\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n                <div class=\\\"value\\\">{{item.description}}</div>\\r\\n              </td>\\r\\n              <td class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n                <div class=\\\"value\\\">{{item.qty}}</div>\\r\\n              </td>\\r\\n              <td class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n                <div class=\\\"value\\\">{{frappe.format_value(item.rate, {\\\"fieldtype\\\":\\\"Currency\\\"})}}</div>\\r\\n              </td>\\r\\n              <td class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n                <div class=\\\"value\\\">{{frappe.format_value(item.amount, {\\\"fieldtype\\\":\\\"Currency\\\"})}}</div>\\r\\n              </td>\\r\\n            </tr>\\r\\n            {% endfor %}\\r\\n            {% if doc.items | length < maxRowsCount %}\\r\\n\\t\\t\\t\\t{% for i in range(0, maxRowsCount - doc.items|length) %}\\r\\n\\t\\t\\t\\t<tr>\\r\\n\\t              <td class=\\\"\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n\\t                <div class=\\\"value\\\">&nbsp</div>\\r\\n\\t              </td>\\r\\n\\t              <td class=\\\"\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n\\t                <div class=\\\"value\\\">&nbsp</div>\\r\\n\\t              </td>\\r\\n\\t              <td class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n\\t                <div class=\\\"value\\\">&nbsp</div>\\r\\n\\t              </td>\\r\\n\\t              <td class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n\\t                <div class=\\\"value\\\">&nbsp</div>\\r\\n\\t              </td>\\r\\n\\t              <td class=\\\"text-right\\\" data-fieldname=\\\"items\\\" data-fieldtype=\\\"Table\\\">\\r\\n\\t                <div class=\\\"value\\\">&nbsp</div>\\r\\n\\t              </td>\\r\\n            </tr>\\r\\n\\t\\t\\t\\t{% endfor %}\\r\\n\\t\\t\\t{% endif %}\\r\\n          </tbody>\\r\\n        </table>\\r\\n      </div>\\r\\n  </div>\\r\\n\\r\\n  \\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \" <div class=\\\"col-xs-6 column-break\\\">\\n\\t        <div class=\\\"row  data-field\\\" data-fieldname=\\\"total_qty\\\" data-fieldtype=\\\"Float\\\">\\n\\t            <div class=\\\"col-xs-5 text-right\\\">\\n\\t                 <label><b>Cantidad Total: {{doc.total_qty}}</b></label>\\n\\t            </div>\\n\\t            <div class=\\\"col-xs-7 text-right value\\\"><b></b></div>\\n\\t        </div>\\n\\t    </div>\\n\\t  \\n\\n\\t    <div class=\\\"col-xs-6 column-break\\\">\\n\\t        <div class=\\\"row  data-field\\\" data-fieldname=\\\"net_total\\\" data-fieldtype=\\\"Currency\\\">\\n\\t            <div class=\\\"row  data-field\\\" data-fieldname=\\\"total\\\" data-fieldtype=\\\"Float\\\">\\n\\t                <div class=\\\"col-xs-5 text-right\\\">\\n\\t                     <label><b> Total Neto: </b><br> </label>\\n\\t                </div>\\n\\t                <div class=\\\"col-xs-7 text-right value\\\">{{doc.get_formatted(\\\"total\\\")}}</div>\\n\\t            </div>\\n\\t        </div>\\n\\t    \\n\\t    \\n\\t        <div class=\\\"row  data-field\\\" data-fieldname=\\\"total_taxes_and_charges\\\" data-fieldtype=\\\"Currency\\\">\\n\\t            <div class=\\\"row  data-field\\\" data-fieldname=\\\"total_taxes_and_charges\\\" data-fieldtype=\\\"Float\\\">\\n\\t                <div class=\\\"col-xs-5 text-right\\\">\\n\\t                     <label><b> ITBIS: </b><br> </label>\\n\\t                </div>\\n\\t                <div class=\\\"col-xs-7 text-right value\\\">{{doc.get_formatted(\\\"total_taxes_and_charges\\\")}}</div>\\n\\t            </div>\\n\\t        </div>\\n\\t    \\n\\t    \\n\\t        <div class=\\\"row  data-field\\\" data-fieldname=\\\"grand_total\\\" data-fieldtype=\\\"Currency\\\">\\n\\t            <div class=\\\"row  data-field\\\" data-fieldname=\\\"grand_total\\\" data-fieldtype=\\\"Float\\\">\\n\\t                <div class=\\\"col-xs-5 text-right\\\">\\n\\t                     <label><b> Total Final: </b><br> </label>\\n\\t                </div>\\n\\t                <div class=\\\"col-xs-7 text-right value\\\">{{doc.get_formatted(\\\"grand_total\\\")}}</div>\\n\\t            </div>\\n\\t        </div>\\n    \\t</div>\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"{% if doc.remarks %}\\r\\n<div class=\\\"col-xs-12 column-break head-details\\\" style=\\\"height: 70px;\\\">\\r\\n    <div class=\\\"row data-field\\\" data-fieldname=\\\"remarks\\\" data-fieldtype=\\\"Float\\\">\\r\\n        <div><b> Notas: </b> {{(doc.remarks)}} <br></div>\\r\\n    </div>\\r\\n</div>\\r\\n{%endif%}\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"\\r\\n<div class=\\\"col-xs-12 column-break\\\">\\r\\n    <div class=\\\"col-xs-12 text-center value\\\">\\r\\n        <div class=\\\"row data-field\\\" data-fieldname=\\\"remarks\\\" data-fieldtype=\\\"Float\\\">\\r\\n             <div><b>\\\"Este documento es obligatorio para retirar su orden de pedido\\\" <br></b></div>\\r\\n             <div><b>Muchas Gracias!</b></div>\\r\\n        </div>\\r\\n    </div>\\r\\n</div>\\r\\n\\r\\n\"}, {\"fieldtype\": \"Section Break\", \"label\": \"\"}, {\"fieldtype\": \"Column Break\"}, {\"fieldname\": \"_custom_html\", \"print_hide\": 0, \"label\": \"Custom HTML\", \"fieldtype\": \"HTML\", \"options\": \"<address></address>\\r\\n<footer id=\\\"footer-html\\\" style=\\\"width:100%; margin-left: 0px;\\\">\\r\\n    <div class=\\\"row section-break\\\">\\r\\n        <div class=\\\"col-xs-4 column-break\\\">\\r\\n            <div class=\\\"div-striped\\\" style=\\\"font-size: 9px;\\\">\\r\\n                <div><b>Oficina Principal:</b><br></div>\\r\\n                <div>Av. Romulo Betancourt No.210 (Casi Esq. Churchill), Bella Vista<br></div>\\r\\n                <div><b>Tel: 809-535-8445, Fax: 809-533-2566</b><br></div>\\r\\n            </div>\\r\\n        </div>\\r\\n        <div class=\\\"col-xs-4 column-break\\\">\\r\\n            <div style=\\\"font-size: 9px;\\\">\\r\\n                <div><b>Santiago:</b><br></div>\\r\\n                <div>Av. 27 de Febrero esq. Estrella Sadhal\\u00e1, Plaza Las Galer\\u00edas 1er Nivel<br></div>\\r\\n                <div><b>Tel: 809-581-9256</b><br></div>\\r\\n            </div>\\r\\n        </div>\\r\\n    </div>\\r\\n    <p class=\\\"text-center small page-number visible-pdf\\\">\\r\\n        <b>Derechos Reservados</b>\\r\\n    </p>\\r\\n</footer>\"}]",
 "html": "<div id=\"header-html\" class=\"hidden-pdf\">\n\n    {%set comp = frappe.db.get_value(\"Comprobantes Conf\", {\"tax_category\": doc.tax_category}, [\"expiration\", \"description\"], as_dict=True)%}\n<div class=\"print-heading\">\t\t\t\t\n    <div>\n        <img src=\"/files/Logo.png\" style=\" float: left;\">\n    </div>\n    <h3>\n        {{comp.description}}\n    </h3>\n        <small>{{ doc.cc_reference }}</small><br>\n        <small>{{ doc.ncf }}</small><br>\n        <small>V\u00c1LIDA HASTA: {{comp.expiration}}</small><br>\n        <small>RNC: 101-16205-8</small>\n    \n</div>\n</div>\n{% if doc.status == \"Draft\" %}\n<div class=\"text-center\" document-status=\"draft\">\n    <h4 style=\"margin: 0px;\">{{_(\"Draft\")}}</h4>\n</div>\n{% endif %}\n\n\n\n<!--<div id=\"footer-html\" class=\"normal-footer visible-pdf\">\n    <div class=\"footer-notes\">\n        {%if doc.terms%}\n        <div>\n          <label class=\"termsname\">NOTAS IMPORTANTES.</label>\n        </div>\n          <div class=\"div-striped\" style=\"bottom: 0;\">\n            {% for termsdesc in doc.terms.split('\\n') %}\n                {{ termsdesc }}\n            {% endfor %}\n          </div>\n        {%endif%}\n     </div>\n  <div class=\"footerinfo\">\n    {% set company = frappe.get_doc(\"Company\", doc.company) %}\n    RNC: {{company.tax_id}} |\n    Tel:\n    {% if company.phone_no %}\n    ({{company.phone_no[0:3]}}) {{company.phone_no[3:6]}}-{{company.phone_no[6:11]}}\n    {% endif %}\n    finanzas@amalog.com.do |\n    {% set companyad = frappe.get_doc(\"Address\", doc.address) %}\n    {{companyad.address_line1}}\n  </div>\n  <p class=\"text-center small page-number visible-pdf\">\n    P\u00e1gina <span class=\"page\"></span> de <span class=\"topage\"></span>\n  </p>\n</div>-->\n\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break\">\n    <div class=\"col-xs-6 column-break\">\n      <div class=\"div-striped\" style=\"font-size: 11px;\">\n        {% set company = frappe.get_doc(\"Company\", doc.company) %}\n        {% if doc.sales_team | length > 0 %}\n        {% set sales_person = frappe.get_doc(\"Sales Person\", doc.sales_team[0].sales_person) %}\n        \n        {% endif %}\n        <div><b>{{_(\"Customer\")}}: </b>{{doc.customer_name}}<br></div>\n        <div><b>RNC/C\u00e9dula:</b> {{doc.tax_id}}<br></div>\n        <div><b>Telefono:</b><br></div>\n        <div><b>Direcci\u00f3n:</b> {{doc.customer_address or \"-\"}} <br></div>\n      </div>\n    </div>\n    <div class=\"col-xs-6 column-break\">\n      <div class=\"div-striped\" style=\"font-size: 11px;\">\n        {% set customer = frappe.get_doc(\"Customer\", doc.customer) %}\n        <div><b>Fecha:</b> {{doc.get_formatted(\"posting_date\")}} <br> </div>\n        <div><b>Vendedor/a: </b>{{doc.sales_partner}}</div>\n        <div><b>Entrega:</b> {{ frappe.format_date(doc.delivery_date)}} @ {{doc.posting_time}} <br></div>\n        <div> <b>Surcursal: </b> Santo Domingo <br></div>\n        {% if doc.contact_person %}\n          {% set contact = frappe.db.get_value(\"Contact\", doc.contact_person, [\"first_name\", \"last_name\", \"mobile_no\", \"email_id\"], as_dict=True) %}\n        <div>{{_(\"Contact\")}}: {{contact.first_name or \"\"}} {{contact.last_name or \"\"}}</div>\n        <div> Email: {{contact.email_id or \"\"}}</div>\n        <div>{{_(\"Phone\")}}: {{contact.mobile_no or \"\"}}</div>\n        {% endif %}\n      </div>\n    </div>\n</div>\n</div>\n\n<hr />\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break\">\n        <div data-fieldname=\"items\" data-fieldtype=\"Table\">\n            <table class=\"table table-condensed\">\n                <thead>\n                    <tr>\n                        <th style=\"width: 200px;\" class=\"\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            {{_(\"Description\")}} </th>\n                        <th style=\"width: 80px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            {{_(\"Quantity\")}} </th>\n                        <th style=\"width: 80px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            {{_(\"Rate\")}} </th>\n                        <th style=\"width: 80px;\" class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            {{_(\"Amount\")}}</th>\n                    </tr>\n                </thead>\n                <tbody>\n\n                    {% for item in doc.items %}\n                    <tr>\n                        <td class=\"\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{item.item_name}}\n                                {%set item_details = frappe.db.get_value(\"Item\", item.item_code, [\"color_primario\", \"color_secundario\"], as_dict=True)%}\n                                {%if item_details.color_primario   %}<br><small>{{ item_details.color_primario   }}</small> {%endif%} \n                                {%if item_details.color_secundario %} <small>{{ item_details.color_secundario }}</small> {%endif%}\n                                {%if item.serial_no %}<br> <b>{{ item.serial_no }}</b> {%endif%}\n                            </div>\n                        </td>\n\n\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{item.qty}}\n                            </div>\n                        </td>\n\n\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{frappe.format_value(item.rate, {\"fieldtype\":\"Currency\"})}}\n                            </div>\n                        </td>\n\n\n\n                        <td class=\"text-right\" data-fieldname=\"items\" data-fieldtype=\"Table\">\n                            <div class=\"value\">\n                                {{frappe.format_value(item.amount, {\"fieldtype\":\"Currency\"})}}\n                            </div>\n                        </td>\n\n\n                    </tr>\n                    {% endfor %}\n                </tbody>\n                <tfoot class=\"total-row text-right\">\n                    <tr>\n\n                        <th>\n                            Subtotal:\n                        </th>\n                        <td colspan=3 style=\"font-size:13px;\">{{doc.get_formatted(\"total\")}}</td>\n                    </tr>\n                    <tr>\n                        <th>Itbis:</th>\n                        <td colspan=3 style=\"font-size:13px;\">{{doc.get_formatted(\"total_taxes_and_charges\")}}</td>\n                    </tr>\n                    <tr>\n                        <th>Descuento:</th>\n                        <td colspan=3 style=\"font-size:13px;\">{{doc.get_formatted(\"discount_amount\")}}</td>\n                    </tr>\n                    <tr>\n                        <th>Total:</th>\n                        <td colspan=3 style=\"font-size:18px;\">{{doc.get_formatted(\"grand_total\")}}</td>\n                    </tr>\n                </tfoot>\n            </table>\n        </div>\n    </div>\n</div>\n\n    <div class=\"row section-break\">\n    <div class=\"col-md-6 column-break\">\n    </div>\n    <div class=\"col-md-6 column-break\">\n        <div style=\"text-align: right;\">\n            <span class=\"vb-text\">{{_(doc.in_words)}}</span>\n        </div>\n    </div>\n</div>\n\n{% if doc.remarks and doc.remarks != \"No Remarks\" %}\n<div class=\"row section-break\">\n    <div class=\"col-xs-12 column-break head-details\" style=\"height: 70px;\">\n        <div class=\"row data-field\" style=\"margin-left: 0px;margin-right: 0px;\" data-fieldname=\"remarks\" data-fieldtype=\"Float\">\n            <div><b> Notas: </b> {{(doc.remarks)}} <br></div>\n        </div>\n    </div>\n</div>\n{%endif%}\n\n<div class=\"row section-break\">\n    <div class=\"col-md-12\">\n        <br>\n        <table>\n            <tr>\n                <td style=\"border: none !important;\">\n                    <span>Facturado por: </span>\n                </td>\n                <td style=\"border: none !important;\">\n                    _______________________\n                </td>\n                <td style=\"border: none !important;\">\n                    <span>Recibido por: </span>\n                </td>\n                <td style=\"border: none !important;\">\n                    _______________________\n                </td>\n            <tr>\n        </table>\n        <br>\n        <strong>\u00a1Gracias por preferirnos!</strong>\n        <br>\n        <span>Favor verificar que su pedido esta bien hecho y completo, luego no podremos aceptar devoluciones.</span>\n    </div>\n</div>\n<div id=\"footer-html\" style=\"width:100%; margin-left: 0px;\">\n    <div class=\"row section-break\">\n        <div class=\"col-xs-4 column-break\">\n            <div style=\"font-size: 9px;\">\n                {%set address = frappe.db.get_value(\"Address\",{\"is_your_company_address\":1}, [\"address_line1\", \"city\", \"county\", \"country\", \"phone\"], as_dict=True)%}\n                <div><b>Oficina Principal:</b><br></div>\n                <div>{{address.address_line1}}, {{address.county}}</div>\n                <!-- <div>{{address.county}}</div> -->\n                <div>{{address.city}}</div>\n                <div><b>Tel\u00e9fono: {{address.phone}}</b></div>\n            </div>\n        </div>\n        <div class=\"col-xs-4 column-break\">\n            <div style=\"font-size: 9px;\">\n                <div><b>Santiago:</b><br></div>\n                <div>Av. 27 de Febrero esq. Estrella Sadhal\u00e1, Plaza Las Galer\u00edas 1er Nivel<br></div>\n                <div><b>Tel: 809-581-9256</b><br></div>\n            </div>\n        </div>\n    </div>\n    <p class=\"text-center small page-number visible-pdf\">\n        <b>Derechos Reservados</b>\n    </p>\n</div>\n",
