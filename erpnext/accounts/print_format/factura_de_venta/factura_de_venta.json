 "creation": "2021-06-18 16:23:39.738673",
 "css": "/* header */\n.head-address{\n    font-size: 10px;\n    width: 270px;\n}\n\n\n/* table */\n.print-format th{\n    background-color: #ffffff !important;\n    color: black;\n}\nth.table-sr{\n text-indent: -9999px;\n  line-height: 0; /* Collapse the original line */\n}\nth.table-sr:after{\n   content: \"No\";\n  text-indent: 0;\n  display: block;\n  line-height: initial; /* New content takes up original line height */\n}\n\ntable {\n    border:none;\n}\ntable tr td, table tr th {\n    border: 1.7px solid #6e6e6e !important;\n}\n\n.total-row {\n    border: none !important;\n}\n.total-row th {\n    text-align: right !important;\n    border: none !important;\n}\n\n.total-row td {\n    font-weight: bold;\n    border: 1.7px solid #6e6e6e;\n}\n\n/* footer */\n.footer-notes {\n    padding-bottom: 3em;\n    padding-top: 0.7em;\n}\n\n.footerinfo {\n    background: #6D6D6D;\n    color: white;\n    font-size: 10px;\n}\n\n\n@media print {\n #footer-html {\n    display: block;\n    position: fixed;\n    bottom: 0;\n    left: 0;\n    width: 100%;\n }\n}",
