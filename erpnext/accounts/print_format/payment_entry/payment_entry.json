 "css": ".heading-block{\n    width: 50%;\n    float: left;\n    height: 100px;\n}\n.print-heading {\n    border-bottom: 0 !important\n}\n.lbl_title{\n    color: #076EBB;\n    border-bottom: 1px solid;\n    \n}\n.info-block{\n    width:100px;\n    float: right;\n}\n.print-format th{\n    background-color: #6ab16a !important;\n    color: white;\n}\nth.table-sr{\n text-indent: -9999px;\n  line-height: 0; /* Collapse the original line */\n}\nth.table-sr:after{\n   content: \"No\";\n  text-indent: 0;\n  display: block;\n  line-height: initial; /* New content takes up original line height */\n}",
 "custom_format": 1,
 "default_print_language": "es",
 "disabled": 0,
 "doc_type": "Payment Entry",
 "docstatus": 0,
 "doctype": "Print Format",
 "font": "Default",
 "html": "<div class=\"print-heading\">\r\n    <div class=\"heading-block text-left\">\r\n        <br><br><h2>{{_(\"Payment Entry\")}}</h2>\r\n    </div>\r\n    <div class=\"heading-block\">\r\n    <img src=\"/files/images/proedom_logo.png\" style=\"height: 65px; float: right;\">\r\n    </div>\r\n</div>\r\n<div class=\"text-center\" document-status=\"draft\">\r\n  <h4 style=\"margin: 0px;\"></h4>\r\n</div>\r\n<div class=\"text-right\">\r\n  <b>{{doc.name}}</b><br> <!-- Secuencia de numero de recibo -->\r\n</div>\r\n\r\n<div id=\"footer-html\" class=\"hidden-pdf\" style=\"order: 1; margin-top: 20px;\">\r\n\r\n  <p class=\"text-center small page-number visible-pdf\">\r\n    P\u00e1gina <span class=\"page\"></span> de <span class=\"topage\"></span>\r\n  </p>\r\n</div>\r\n\r\n\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n    <div class=\"row important data-field\" data-fieldname=\"posting_date\" data-fieldtype=\"Date\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Fecha de Contabilizaci\u00f3n</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.posting_date}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"row  data-field\" data-fieldname=\"mode_of_payment\" data-fieldtype=\"Link\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>M\u00e9todo de pago</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\nvalue\">\r\n        {{doc.mode_of_payment}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n    <div class=\"row important data-field\" data-fieldname=\"party\" data-fieldtype=\"Dynamic Link\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Cliente</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.party}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"row  data-field\" data-fieldname=\"party_name\" data-fieldtype=\"Data\">\r\n      <div class=\"col-xs-5\">\r\n\r\n\r\n        <label>Nombre del Tercero</label>\r\n\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.party_name}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n    <div class=\"row  data-field\" data-fieldname=\"contact_person\" data-fieldtype=\"Link\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Contacto</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.contact_person}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"row  data-field\" data-fieldname=\"contact_email\" data-fieldtype=\"Data\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Correo electr\u00f3nico (Email)</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.contact_email}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n    <div class=\"row important data-field\" data-fieldname=\"paid_amount\" data-fieldtype=\"Currency\">\r\n      <div class=\"col-xs-5\">\r\n\r\n\r\n        <label>Monto Pagado</label>\r\n\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\ntext-right value\">\r\n        {{frappe.format_value(doc.paid_amount, {\"fieldtype\":\"Currency\"})}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-12 column-break\">\r\n\r\n    <div data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n      <table class=\"table table-bordered table-condensed\">\r\n        <thead>\r\n          <tr>\r\n            <th style=\"width: 40px\" class=\"table-sr\">Sr</th>\r\n\r\n            <th style=\"width: 150px;\" class=\"\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              Tipo de Documento</th>\r\n\r\n            <th style=\"width: 150px;\" class=\"\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              N\u00famero de Documento</th>\r\n\r\n            <th style=\"width: 150px;\" class=\"\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              Fecha de vencimiento</th>\r\n\r\n          <!--  <th style=\"width: 80px;\" class=\"text-right\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              Total Excepcional</th> -->\r\n\r\n            <th style=\"width: 80px;\" class=\"text-right\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              Total</th>\r\n\r\n\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          {% set i = 0 %}\r\n\r\n          {% for reference in doc.references %}\r\n          {%set Currency = frappe.db.get_value(\"Sales Invoice\", doc.sales_invoice, \"currency\") %}\r\n          <tr>\r\n            <td class=\"table-sr\">{{i}}</td>\r\n\r\n            <td class=\"\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              <div class=\"value\">{{reference.reference_doctype}}\r\n              </div>\r\n            </td>\r\n\r\n            <td class=\"\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              <div class=\"value\">{{reference.reference_name}}\r\n              </div>\r\n            </td>\r\n\r\n            <td class=\"\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              <div class=\"value\">{{reference.due_date}}\r\n              </div>\r\n            </td>\r\n\r\n        <!--    <td class=\"text-right\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              <div class=\"value\">{{frappe.format_value(reference.outstanding_amount, {\"fieldtype\":\"Currency\"})}}\r\n              </div>\r\n            </td> -->\r\n\r\n            <td class=\"text-right\" data-fieldname=\"references\" data-fieldtype=\"Table\">\r\n              <div class=\"value\">{{frappe.format_value(reference.allocated_amount, {\"fieldtype\":\"Currency\"})}}\r\n\r\n              </div>\r\n            </td>\r\n\r\n          </tr>\r\n          {% set i = i + 1 %}\r\n          {% endfor %}\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n    <div class=\"row important data-field\" data-fieldname=\"reference_no\" data-fieldtype=\"Data\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Cheque / No. de Referencia</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.reference_no}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n    <div class=\"row important data-field\" data-fieldname=\"reference_date\" data-fieldtype=\"Date\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Cheque / Fecha de referencia</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.reference_date}}\r\n\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n<div class=\"row section-break\">\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n    <div class=\"row  data-field\" data-fieldname=\"status\" data-fieldtype=\"Select\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Estado</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.status}}\r\n      </div>\r\n    </div>\r\n\r\n    <div class=\"row  data-field\" data-fieldname=\"remarks\" data-fieldtype=\"Small Text\">\r\n      <div class=\"col-xs-5\">\r\n\r\n        <label>Observaciones</label>\r\n\r\n      </div>\r\n      <div class=\"col-xs-7\r\n value\">\r\n        {{doc.remarks}}\r\n      </div>\r\n    </div>\r\n\r\n  </div>\r\n\r\n  <div class=\"col-xs-6 column-break\">\r\n\r\n  </div>\r\n\r\n</div>\r\n\r\n<div class=\"text-center\">\r\n  <br><br><br><br><br>__________________________________________<br>\r\n  {% if paytype == \"Receive\" %}\r\n  <b>Recibido por</b>\r\n  {% endif %}\r\n\r\n  {% if paytype == \"Pay\" %}\r\n  <b>Registrado por</b>\r\n  {% endif %}\r\n</div>\r\n",
